# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VedaMilan AI
LOG_LEVEL=info
MAINTENANCE_MODE=false

# Database (MongoDB Atlas) — authoritative
# Prefer mongodb+srv:// … If Node on Windows hits querySrv ECONNREFUSED, the app auto-resolves via DNS-over-HTTPS.
# Optional manual override (skip SRV entirely):
# MONGODB_URI_STANDARD=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/vedamilan?ssl=true&replicaSet=REPLICAS&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/vedamilan?retryWrites=true&w=majority

# Legacy (deprecated — do not use for new work)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vedic_match?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication (Better Auth)
# Production: must be a strong random secret, at least 32 characters.
BETTER_AUTH_SECRET=replace-with-32-char-minimum-secret-key
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# AI providers (Mastra model router — explain-only agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=VedaMilan AI <noreply@vedamilan.ai>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Realtime (Pusher)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# Swiss Ephemeris ephemeris files directory
SWISS_EPHEMERIS_PATH=./ephe
