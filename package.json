{
  "name": "vedamilan-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:indexes": "tsx src/infrastructure/database/ensure-indexes.ts",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:db": "vitest run src/infrastructure/database src/repositories",
    "test:auth": "vitest run src/lib/auth",
    "test:profile": "vitest run src/application/profile",
    "test:horoscope": "vitest run src/application/horoscope",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
