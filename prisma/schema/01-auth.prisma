/// Core identity record. Soft-deletable; authentication artifacts hang off this root.
model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  email         String       @unique @db.Citext
  emailVerified Boolean      @default(false) @map("email_verified")
  phone         String?      @unique @db.VarChar(20)
  phoneVerified Boolean      @default(false) @map("phone_verified")
  passwordHash  String?      @map("password_hash")
  /// Better Auth `name` field (mapped for adapter compatibility).
  name          String       @default("") @db.VarChar(120)
  displayName   String?      @map("display_name") @db.VarChar(120)
  image         String?
  lastLoginAt   DateTime?    @map("last_login_at") @db.Timestamptz(6)
  isBanned      Boolean      @default(false) @map("is_banned")
  bannedReason  String?      @map("banned_reason")
  locale        Language     @default(ENGLISH)
  timezone      String       @default("Asia/Kolkata") @db.VarChar(64)

  sessions            Session[]
  accounts            Account[]
  refreshTokens       RefreshToken[]
  loginHistory        LoginHistory[]
  devices             Device[]
  otps                Otp[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  socialLogins        SocialLogin[]
  userRoles           UserRole[]

  profile             UserProfile?
  birthDetails        BirthDetails?
  privacySettings     PrivacySettings?
  partnerPreference   PartnerPreference?

  profileImages       ProfileImage[]
  documents           UserDocument[]
  verificationDocs    VerificationDocument[]
  galleryItems        GalleryItem[]
  educationRecords    Education[]
  careerRecords       Career[]
  lifestyle           Lifestyle?
  religionProfile     ReligionProfile?
  communityProfile    CommunityProfile?
  userLanguages       UserLanguage[]
  hobbies             UserHobby[]
  interests           UserInterest[]
  locations           UserLocation[]

  blockedUsers        BlockedUser[]          @relation("Blocker")
  blockedByUsers      BlockedUser[]          @relation("Blocked")
  reportedUsers       ReportedUser[]         @relation("Reporter")
  reportsAgainst      ReportedUser[]         @relation("Reported")
  savedProfiles       SavedProfile[]         @relation("Saver")
  savedByProfiles     SavedProfile[]         @relation("Saved")
  recentlyViewed      RecentlyViewedProfile[] @relation("Viewer")
  viewedBy            RecentlyViewedProfile[] @relation("Viewed")
  shortlisted         ShortlistedProfile[]   @relation("Shortlister")
  shortlistedBy       ShortlistedProfile[]   @relation("Shortlisted")

  horoscopeCharts     HoroscopeChart[]
  dashaTimelines      DashaTimeline[]
  dashaWindows        DashaWindow[]

  compatibilityAsA    CompatibilityReport[]  @relation("CompatUserA")
  compatibilityAsB    CompatibilityReport[]  @relation("CompatUserB")

  aiReports           AiReport[]
  promptHistory       AiPromptHistory[]
  aiRecommendations   AiRecommendation[]
  aiEmbeddings        AiEmbedding[]
  aiMemories          AiMemory[]
  aiConversations     AiConversationContext[]
  aiTokenUsages       AiTokenUsage[]

  likesSent           Like[]                 @relation("Liker")
  likesReceived       Like[]                 @relation("Liked")
  interestsSent       Interest[]             @relation("InterestFrom")
  interestsReceived   Interest[]             @relation("InterestTo")
  mutualMatchesA      MutualMatch[]          @relation("MutualA")
  mutualMatchesB      MutualMatch[]          @relation("MutualB")
  connectionRequestsSent     ConnectionRequest[] @relation("ConnFrom")
  connectionRequestsReceived ConnectionRequest[] @relation("ConnTo")
  acceptedMatchesA    AcceptedMatch[]        @relation("AcceptedA")
  acceptedMatchesB    AcceptedMatch[]        @relation("AcceptedB")
  rejectedMatchesSent RejectedMatch[]        @relation("Rejector")
  rejectedMatchesRecv RejectedMatch[]        @relation("Rejected")
  blockedMatchesSent  BlockedMatch[]         @relation("MatchBlocker")
  blockedMatchesRecv  BlockedMatch[]         @relation("MatchBlocked")
  matchRecommendations MatchRecommendation[]

  conversationParticipants ConversationParticipant[]
  messagesSent        Message[]
  readReceipts        ReadReceipt[]
  attachments         MessageAttachment[]
  voiceNotes          VoiceNote[]
  videoCallsInitiated VideoCall[]            @relation("CallInitiator")
  callHistory         CallHistory[]
  deletedMessages     DeletedMessage[]

  notifications       Notification[]
  notificationPrefs   NotificationPreference[]

  subscriptions       Subscription[]
  invoices            Invoice[]
  paymentTransactions PaymentTransaction[]
  wallet              Wallet?
  refunds             Refund[]
  razorpayOrders      RazorpayOrder[]
  stripePayments      StripePayment[]

  generatedReports    GeneratedReport[]
  reportDownloads     ReportDownload[]

  astrologerProfile   Astrologer?
  consultationBookings ConsultationBooking[] @relation("ClientBookings")
  consultationReviews ConsultationReview[]   @relation("Reviewer")

  blogPosts           BlogPost[]             @relation("Author")
  blogComments        BlogComment[]
  testimonials        Testimonial[]
  successStories      SuccessStory[]

  adminProfile        Admin?
  auditLogs           AuditLog[]             @relation("Actor")
  activityLogs        ActivityLog[]

  marriageTimingWindows MarriageTimingWindow[]
  careerTimingWindows CareerTimingWindow[]
  educationTimingWindows EducationTimingWindow[]
  foreignSettlementWindows ForeignSettlementWindow[]
  horoscopePdfReports HoroscopePdfReport[]
  compatibilityPdfReports CompatibilityPdfReport[]
  marriageTimingPdfReports MarriageTimingPdfReport[]
  aiSummaryPdfReports AiSummaryPdfReport[]
  pushNotifications   PushNotification[]
  emailNotifications  EmailNotification[]
  smsNotifications    SmsNotification[]
  inAppNotifications  InAppNotification[]
  couponRedemptions   CouponRedemption[]
  stripeCustomers     StripeCustomer[]

  @@index([status, deletedAt])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([phone])
  @@index([name])
  @@map("users")
}

model Session {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  token         String       @unique
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  ipAddress     String?      @map("ip_address") @db.VarChar(64)
  userAgent     String?      @map("user_agent")
  deviceId      String?      @map("device_id") @db.Uuid

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([status, deletedAt])
  @@map("sessions")
}

model Account {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  accountId     String       @map("account_id")
  providerId    String       @map("provider_id")
  accessToken   String?      @map("access_token")
  refreshToken  String?      @map("refresh_token")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope         String?
  idToken       String?      @map("id_token")
  password      String?

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([status, deletedAt])
  @@map("accounts")
}

/// Better Auth verification tokens (email verify, password reset, magic link).
model Verification {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  identifier    String       @db.VarChar(255)
  value         String
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
}

model RefreshToken {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?    @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?  @map("replaced_by_token_id") @db.Uuid
  deviceId      String?      @map("device_id") @db.Uuid

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([status, deletedAt])
  @@map("refresh_tokens")
}

model LoginHistory {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  success       Boolean
  ipAddress     String?      @map("ip_address") @db.VarChar(64)
  userAgent     String?      @map("user_agent")
  failureReason String?      @map("failure_reason")
  locationLabel String?      @map("location_label")
  deviceId      String?      @map("device_id") @db.Uuid

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([success, createdAt])
  @@index([status, deletedAt])
  @@map("login_history")
}

model Device {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  deviceFingerprint String   @map("device_fingerprint")
  platform      String?      @db.VarChar(64)
  osVersion     String?      @map("os_version") @db.VarChar(64)
  appVersion    String?      @map("app_version") @db.VarChar(64)
  pushToken     String?      @map("push_token")
  lastSeenAt    DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  trusted       Boolean      @default(false)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      Session[]
  refreshTokens RefreshToken[]
  loginHistory  LoginHistory[]
  pushNotifications PushNotification[]

  @@unique([userId, deviceFingerprint])
  @@index([pushToken])
  @@index([status, deletedAt])
  @@map("devices")
}

model Otp {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String?      @map("user_id") @db.Uuid
  destination   String
  purpose       OtpPurpose
  codeHash      String       @map("code_hash")
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5) @map("max_attempts")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?    @map("consumed_at") @db.Timestamptz(6)

  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([destination, purpose, expiresAt])
  @@index([userId, purpose])
  @@index([status, deletedAt])
  @@map("otps")
}

model PasswordReset {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?    @map("used_at") @db.Timestamptz(6)
  ipAddress     String?      @map("ip_address") @db.VarChar(64)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([status, deletedAt])
  @@map("password_resets")
}

model EmailVerification {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  email         String       @db.Citext
  tokenHash     String       @unique @map("token_hash")
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  verifiedAt    DateTime?    @map("verified_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email])
  @@index([status, deletedAt])
  @@map("email_verifications")
}

model SocialLogin {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  provider      SocialProvider
  providerUserId String      @map("provider_user_id")
  email         String?      @db.Citext
  profileUrl    String?      @map("profile_url")
  rawProfile    Json?        @map("raw_profile")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([status, deletedAt])
  @@map("social_logins")
}

model AppRole {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  code          Role         @unique
  name          String       @db.VarChar(120)
  description   String?

  userRoles     UserRole[]
  rolePermissions RolePermission[]

  @@index([status, deletedAt])
  @@map("app_roles")
}

model Permission {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  code          String       @unique @db.VarChar(120)
  resource      String       @db.VarChar(120)
  action        String       @db.VarChar(64)
  description   String?

  rolePermissions RolePermission[]
  permissionLogs  PermissionLog[]

  @@unique([resource, action])
  @@index([status, deletedAt])
  @@map("permissions")
}

model UserRole {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  roleId        String       @map("role_id") @db.Uuid
  assignedAt    DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          AppRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([status, deletedAt])
  @@map("user_roles")
}

model RolePermission {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  roleId        String       @map("role_id") @db.Uuid
  permissionId  String       @map("permission_id") @db.Uuid

  role          AppRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([status, deletedAt])
  @@map("role_permissions")
}
