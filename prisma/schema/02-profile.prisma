/// Geographic reference data (normalized; City enum is for filters only).
model GeoCountry {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  code          Country      @unique
  name          String       @db.VarChar(120)
  phoneCode     String?      @map("phone_code") @db.VarChar(8)
  states        GeoState[]
  cities        GeoCity[]
  userLocations UserLocation[]

  @@index([status, deletedAt])
  @@map("geo_countries")
}

model GeoState {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  countryId     String       @map("country_id") @db.Uuid
  code          State
  name          String       @db.VarChar(120)
  country       GeoCountry   @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities        GeoCity[]
  userLocations UserLocation[]

  @@unique([countryId, code])
  @@index([status, deletedAt])
  @@map("geo_states")
}

model GeoCity {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  countryId     String       @map("country_id") @db.Uuid
  stateId       String?      @map("state_id") @db.Uuid
  name          String       @db.VarChar(160)
  cityEnum      City?        @map("city_enum")
  latitude      Decimal?     @db.Decimal(10, 7)
  longitude     Decimal?     @db.Decimal(10, 7)
  timezone      String?      @db.VarChar(64)

  country       GeoCountry   @relation(fields: [countryId], references: [id], onDelete: Restrict)
  state         GeoState?    @relation(fields: [stateId], references: [id], onDelete: SetNull)
  userLocations UserLocation[]
  birthPlaces   BirthDetails[]

  @@unique([countryId, stateId, name])
  @@index([cityEnum])
  @@index([name])
  @@index([status, deletedAt])
  @@map("geo_cities")
}

model UserProfile {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @unique @map("user_id") @db.Uuid
  firstName     String       @map("first_name") @db.VarChar(80)
  middleName    String?      @map("middle_name") @db.VarChar(80)
  lastName      String?      @map("last_name") @db.VarChar(80)
  gender        Gender
  maritalStatus MaritalStatus @map("marital_status")
  relationshipIntent RelationshipIntent @default(MARRIAGE) @map("relationship_intent")
  heightCm      Int?         @map("height_cm")
  weightKg      Int?         @map("weight_kg")
  heightRange   HeightRange? @map("height_range")
  weightRange   WeightRange? @map("weight_range")
  bloodGroup    String?      @map("blood_group") @db.VarChar(8)
  complexion    String?      @db.VarChar(40)
  motherTongue  Language?    @map("mother_tongue")
