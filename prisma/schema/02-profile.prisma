  profileCompleteness Int     @default(0) @map("profile_completeness")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  isProfileComplete Boolean  @default(false) @map("is_profile_complete")
  profileSlug   String?      @unique @map("profile_slug") @db.VarChar(120)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           ProfileBio?

  @@index([gender, maritalStatus, status])
  @@index([verificationStatus])
  @@index([profileCompleteness])
