model BirthDetails {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @unique @map("user_id") @db.Uuid
  dateOfBirth   DateTime     @map("date_of_birth") @db.Date
  birthTime     DateTime     @map("birth_time") @db.Timestamptz(6)
  birthPlaceLabel String     @map("birth_place_label") @db.VarChar(200)
  geoCityId     String?      @map("geo_city_id") @db.Uuid
  latitude      Decimal      @db.Decimal(10, 7)
  longitude     Decimal      @db.Decimal(10, 7)
  timezone      String       @db.VarChar(64)
  utcOffsetMinutes Int       @map("utc_offset_minutes")
  dstObserved   Boolean      @default(false) @map("dst_observed")
  sourceAccuracy String      @map("source_accuracy") @db.VarChar(40)
  birthCertificateUploaded Boolean @default(false) @map("birth_certificate_uploaded")
  birthCertificateUrl String? @map("birth_certificate_url")
  julianDayUt   Decimal?     @map("julian_day_ut") @db.Decimal(18, 10)
  ayanamsa      String?      @default("LAHIRI") @db.VarChar(40)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  geoCity       GeoCity?     @relation(fields: [geoCityId], references: [id], onDelete: SetNull)

  @@index([dateOfBirth])
  @@index([latitude, longitude])
  @@index([status, deletedAt])
  @@map("birth_details")
}
