/// Root natal / derived chart record for a user.
model HoroscopeChart {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  chartType     HoroscopeType @map("chart_type")
  reportStatus  AstrologyReportStatus @default(QUEUED) @map("report_status")
  ayanamsa      String       @default("LAHIRI") @db.VarChar(40)
  houseSystem   String       @default("WHOLE_SIGN") @map("house_system") @db.VarChar(40)
  lagnaSign     ZodiacSign?  @map("lagna_sign")
  moonSign      ZodiacSign?  @map("moon_sign")
  sunSign       ZodiacSign?  @map("sun_sign")
  computedAt    DateTime?    @map("computed_at") @db.Timestamptz(6)
  engineVersion String?      @map("engine_version") @db.VarChar(40)
  rawPayload    Json?        @map("raw_payload")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planetPositions PlanetPosition[]
  planetDegrees PlanetDegree[]
  houses        HouseCusp[]
  houseLords    HouseLord[]
  nakshatras    NakshatraPlacement[]
  padas         PadaPlacement[]
  signs         SignPlacement[]
  planetStrengths PlanetStrength[]
  shadbala      Shadbala[]
  exaltations   Exaltation[]
  debilitations Debilitation[]
  combustions   Combustion[]
  retrogrades   Retrograde[]
  conjunctions  Conjunction[]
  aspects       Aspect[]
  planetaryYogas PlanetaryYoga[]
  rajYogas      RajYoga[]
  dhanaYogas    DhanaYoga[]
  vipreetRajYogas VipreetRajYoga[]
  neechaBhangas NeechaBhanga[]
  doshas        Dosha[]
  manglik       ManglikDosha?
  kaalSarp      KaalSarpDosha?
  pitruDosha    PitruDosha?
  nadi          NadiAttribute?
  bhakoot       BhakootAttribute?
  yoni          YoniAttribute?
  varna         VarnaAttribute?
  vashya        VashyaAttribute?
  tara          TaraAttribute?
  gana          GanaAttribute?
  grahaMaitri   GrahaMaitriAttribute?
  navamsa       NavamsaChart?
  dashamsa      DashamsaChart?
  moonChart     MoonChartDetail?
  kpData        KpData?
  jaiminiData   JaiminiData?
  upapadaLagna  UpapadaLagna?
  darakaraka    Darakaraka?
  atmakaraka    Atmakaraka?
  karakamsa     Karakamsa?
  horoscopePdfReports HoroscopePdfReport[]

  @@unique([userId, chartType])
  @@index([reportStatus, computedAt])
  @@index([status, deletedAt])
  @@map("horoscope_charts")
}

model PlanetPosition {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  chartId       String       @map("chart_id") @db.Uuid
  planet        PlanetName
  longitude     Decimal      @db.Decimal(10, 6)
  latitude      Decimal      @db.Decimal(10, 6)
  speed         Decimal      @db.Decimal(10, 6)
  houseNumber   Int          @map("house_number")
  sign          ZodiacSign
  isRetrograde  Boolean      @default(false) @map("is_retrograde")

  chart         HoroscopeChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, planet])
  @@index([planet, sign])
  @@index([status, deletedAt])
  @@map("planet_positions")
}

