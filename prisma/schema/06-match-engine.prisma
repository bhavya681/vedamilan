model ConflictIndicator {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  reportId      String       @map("report_id") @db.Uuid
  code          String       @db.VarChar(80)
  severity      String       @db.VarChar(40)
  description   String
  mitigation    String?

  report        CompatibilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, severity])
  @@index([status, deletedAt])
  @@map("conflict_indicators")
}
