model AiReport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  reportType    String       @map("report_type") @db.VarChar(80)
  title         String       @db.VarChar(200)
  contentMarkdown String     @map("content_markdown")
  provider      AiProvider   @default(OPENAI)
  model         String       @db.VarChar(80)
  reportStatus  AstrologyReportStatus @default(COMPLETED) @map("report_status")
  tokenUsageId  String?      @map("token_usage_id") @db.Uuid

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedReports GeneratedAiReport[]
  explanations  AiExplanationCache[]
  pdfReports    AiSummaryPdfReport[]

  @@index([userId, reportType, createdAt])
  @@index([status, deletedAt])
  @@map("ai_reports")
}

model AiPromptHistory {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String?      @map("user_id") @db.Uuid
  purpose       String       @db.VarChar(80)
  prompt        String
  response      String?
  provider      AiProvider   @default(OPENAI)
  model         String       @db.VarChar(80)
  latencyMs     Int?         @map("latency_ms")
  success       Boolean      @default(true)

  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([purpose, createdAt])
  @@index([status, deletedAt])
  @@map("ai_prompt_history")
}

model GeneratedAiReport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  aiReportId    String       @map("ai_report_id") @db.Uuid
  version       Int          @default(1)
  contentJson   Json         @map("content_json")
  checksum      String       @db.VarChar(128)

  aiReport      AiReport     @relation(fields: [aiReportId], references: [id], onDelete: Cascade)

  @@unique([aiReportId, version])
  @@index([status, deletedAt])
  @@map("generated_ai_reports")
}

model AiRecommendation {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  recommendedUserId String   @map("recommended_user_id") @db.Uuid
  score         Decimal      @db.Decimal(5, 2)
  reasonCodes   String[]     @map("reason_codes")
  explanation   String?
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, score])
  @@index([recommendedUserId])
  @@index([status, deletedAt])
  @@map("ai_recommendations")
}

model AiExplanationCache {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  aiReportId    String?      @map("ai_report_id") @db.Uuid
  cacheKey      String       @unique @map("cache_key") @db.VarChar(191)
  explanation   String
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)

  aiReport      AiReport?    @relation(fields: [aiReportId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([status, deletedAt])
  @@map("ai_explanation_cache")
}

model AiEmbedding {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String?      @map("user_id") @db.Uuid
  source        EmbeddingSource
  sourceRefId   String?      @map("source_ref_id") @db.Uuid
  model         String       @db.VarChar(80)
  dimensions    Int
  /// Store embedding as float array JSON until pgvector extension is provisioned in all environments.
  vectorJson    Json         @map("vector_json")
  contentHash   String       @map("content_hash") @db.VarChar(128)

  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, sourceRefId, model])
  @@index([userId, source])
  @@index([contentHash])
  @@index([status, deletedAt])
  @@map("ai_embeddings")
}

model AiMemory {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  memoryKey     String       @map("memory_key") @db.VarChar(120)
  memoryValue   Json         @map("memory_value")
  importance    Int          @default(1)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, memoryKey])
  @@index([status, deletedAt])
  @@map("ai_memories")
}

model AiConversationContext {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
