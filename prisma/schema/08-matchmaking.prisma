}

model RejectedMatch {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  rejectorId    String       @map("rejector_id") @db.Uuid
  rejectedId    String       @map("rejected_id") @db.Uuid
  reason        String?      @db.VarChar(280)
  matchStatus   MatchStatus  @default(REJECTED) @map("match_status")

  rejector      User         @relation("Rejector", fields: [rejectorId], references: [id], onDelete: Cascade)
  rejected      User         @relation("Rejected", fields: [rejectedId], references: [id], onDelete: Cascade)

  @@unique([rejectorId, rejectedId])
  @@index([rejectedId])
  @@index([status, deletedAt])
  @@map("rejected_matches")
}

model BlockedMatch {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  blockerId     String       @map("blocker_id") @db.Uuid
  blockedId     String       @map("blocked_id") @db.Uuid
  reason        String?
  matchStatus   MatchStatus  @default(BLOCKED) @map("match_status")

  blocker       User         @relation("MatchBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked       User         @relation("MatchBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([status, deletedAt])
  @@map("blocked_matches")
}

model MatchRecommendation {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  candidateUserId String     @map("candidate_user_id") @db.Uuid
  score         Decimal      @db.Decimal(5, 2)
  matchStatus   MatchStatus  @default(SUGGESTED) @map("match_status")
  algorithmVersion String    @map("algorithm_version") @db.VarChar(40)
  featuresJson  Json         @map("features_json")
  shownAt       DateTime?    @map("shown_at") @db.Timestamptz(6)
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz(6)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, candidateUserId, algorithmVersion])
  @@index([userId, score])
  @@index([candidateUserId])
  @@index([status, deletedAt])
  @@map("match_recommendations")
}
