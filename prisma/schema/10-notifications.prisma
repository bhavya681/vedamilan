model Notification {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  type          NotificationType
  channel       NotificationChannel
  title         String       @db.VarChar(200)
  body          String
  payloadJson   Json?        @map("payload_json")
  readAt        DateTime?    @map("read_at") @db.Timestamptz(6)
  sentAt        DateTime?    @map("sent_at") @db.Timestamptz(6)
  templateId    String?      @map("template_id") @db.Uuid

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs          NotificationLog[]

  @@index([userId, readAt, createdAt])
  @@index([type, channel, createdAt])
  @@index([status, deletedAt])
  @@map("notifications")
}

model NotificationPreference {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  type          NotificationType
  channel       NotificationChannel
  enabled       Boolean      @default(true)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([status, deletedAt])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  code          String       @unique @db.VarChar(80)
  type          NotificationType
  channel       NotificationChannel
  subject       String?      @db.VarChar(200)
  bodyTemplate  String       @map("body_template")
  locale        Language     @default(ENGLISH)

  notifications Notification[]
  logs          NotificationLog[]

  @@index([type, channel])
  @@index([status, deletedAt])
  @@map("notification_templates")
}

model NotificationLog {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  notificationId String?     @map("notification_id") @db.Uuid
  templateId    String?      @map("template_id") @db.Uuid
  channel       NotificationChannel
  providerRef   String?      @map("provider_ref") @db.VarChar(160)
  deliveryStatus String      @map("delivery_status") @db.VarChar(40)
  errorMessage  String?      @map("error_message")
  metaJson      Json?        @map("meta_json")

  notification  Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  template      NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([channel, createdAt])
  @@index([deliveryStatus, createdAt])
  @@index([status, deletedAt])
  @@map("notification_logs")
}
