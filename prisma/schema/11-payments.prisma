  @@index([userId, createdAt])
  @@index([paymentTransactionId])
  @@index([paymentStatus])
  @@index([status, deletedAt])
  @@map("razorpay_orders")
}

model StripePayment {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  paymentTransactionId String? @map("payment_transaction_id") @db.Uuid
  stripePaymentIntentId String @unique @map("stripe_payment_intent_id")
  stripeCustomerId String?   @map("stripe_customer_id")
  amountMinor   Int          @map("amount_minor")
  currency      String       @default("USD") @db.VarChar(8)
  paymentStatus PaymentStatus @default(CREATED) @map("payment_status")
  metaJson      Json?        @map("meta_json")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([paymentTransactionId])
  @@index([paymentStatus])
  @@index([status, deletedAt])
  @@map("stripe_payments")
}

model StripeCustomer {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @unique @map("user_id") @db.Uuid
  stripeCustomerId String    @unique @map("stripe_customer_id")
  defaultCurrency String     @default("USD") @map("default_currency") @db.VarChar(8)
  metaJson      Json?        @map("meta_json")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, deletedAt])
  @@map("stripe_customers")
}

model PaymentWebhookEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  provider      String       @db.VarChar(40)
  eventId       String       @map("event_id") @db.VarChar(191)
  eventType     String       @map("event_type") @db.VarChar(120)
  payloadJson   Json         @map("payload_json")
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  processingError String?    @map("processing_error")

  @@unique([provider, eventId])
  @@index([eventType, createdAt])
  @@index([processedAt])
  @@index([status, deletedAt])
  @@map("payment_webhook_events")
}
