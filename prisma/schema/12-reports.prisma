model GeneratedReport {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @map("user_id") @db.Uuid
  reportKind    String       @map("report_kind") @db.VarChar(80)
  title         String       @db.VarChar(200)
  format        ReportFormat @default(PDF)
  storageUrl    String?      @map("storage_url")
  reportStatus  AstrologyReportStatus @default(QUEUED) @map("report_status")
  sourceRefId   String?      @map("source_ref_id") @db.Uuid
  metaJson      Json?        @map("meta_json")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  downloads     ReportDownload[]

  @@index([userId, reportKind, createdAt])
  @@index([reportStatus])
  @@index([status, deletedAt])
  @@map("generated_reports")
}

model ReportDownload {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  reportId      String       @map("report_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  downloadedAt  DateTime     @default(now()) @map("downloaded_at") @db.Timestamptz(6)
  ipAddress     String?      @map("ip_address") @db.VarChar(64)

  report        GeneratedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportId, downloadedAt])
  @@index([userId, downloadedAt])
  @@index([status, deletedAt])
  @@map("report_downloads")
}
