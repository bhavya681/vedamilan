model Astrologer {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  userId        String       @unique @map("user_id") @db.Uuid
  displayName   String       @map("display_name") @db.VarChar(120)
  bio           String?
  experienceYears Int        @map("experience_years")
  specialties   String[]
  languages     Language[]
  hourlyRateMinor Int        @map("hourly_rate_minor")
  currency      String       @default("INR") @db.VarChar(8)
  isVerified    Boolean      @default(false) @map("is_verified")
  ratingAvg     Decimal      @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount   Int          @default(0) @map("rating_count")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  AstrologerAvailability[]
  bookings      ConsultationBooking[]
  reviews       ConsultationReview[]

  @@index([isVerified, ratingAvg])
  @@index([status, deletedAt])
  @@map("astrologers")
}

model AstrologerAvailability {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  astrologerId  String       @map("astrologer_id") @db.Uuid
  dayOfWeek     Int          @map("day_of_week")
  startTimeUtc  String       @map("start_time_utc") @db.VarChar(8)
  endTimeUtc    String       @map("end_time_utc") @db.VarChar(8)
  timezone      String       @db.VarChar(64)

  astrologer    Astrologer   @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  @@unique([astrologerId, dayOfWeek, startTimeUtc, endTimeUtc])
  @@index([status, deletedAt])
  @@map("astrologer_availability")
}

model ConsultationBooking {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  clientId      String       @map("client_id") @db.Uuid
  astrologerId  String       @map("astrologer_id") @db.Uuid
  scheduledStart DateTime    @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd  DateTime     @map("scheduled_end") @db.Timestamptz(6)
  bookingStatus BookingStatus @default(REQUESTED) @map("booking_status")
  amountMinor   Int          @map("amount_minor")
  currency      String       @default("INR") @db.VarChar(8)
  notes         String?

  client        User         @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  astrologer    Astrologer   @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  meeting       ConsultationMeeting?
  payment       ConsultationPayment?
  review        ConsultationReview?

  @@index([clientId, scheduledStart])
  @@index([astrologerId, scheduledStart])
  @@index([bookingStatus])
  @@index([status, deletedAt])
  @@map("consultation_bookings")
}

model ConsultationMeeting {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  bookingId     String       @unique @map("booking_id") @db.Uuid
  meetingUrl    String?      @map("meeting_url")
  providerRoomId String?     @map("provider_room_id") @db.VarChar(160)
  startedAt     DateTime?    @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?    @map("ended_at") @db.Timestamptz(6)
  recordingUrl  String?      @map("recording_url")

  booking       ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, deletedAt])
  @@map("consultation_meetings")
}

model ConsultationReview {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  bookingId     String       @unique @map("booking_id") @db.Uuid
  reviewerId    String       @map("reviewer_id") @db.Uuid
  astrologerId  String       @map("astrologer_id") @db.Uuid
  rating        Int
  title         String?      @db.VarChar(160)
  body          String?

  booking       ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer      User         @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  astrologer    Astrologer   @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([astrologerId, rating])
  @@index([status, deletedAt])
  @@map("consultation_reviews")
}

model ConsultationPayment {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  bookingId     String       @unique @map("booking_id") @db.Uuid
  amountMinor   Int          @map("amount_minor")
  currency      String       @default("INR") @db.VarChar(8)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  provider      String?      @db.VarChar(40)
  providerPaymentId String?  @map("provider_payment_id")

  booking       ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@index([status, deletedAt])
  @@map("consultation_payments")
}
