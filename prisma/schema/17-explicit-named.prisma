/// Explicit Vimshottari period tables (in addition to polymorphic DashaPeriod).
model Mahadasha {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  timelineId    String       @map("timeline_id") @db.Uuid
  lord          PlanetName
  startAt       DateTime     @map("start_at") @db.Timestamptz(6)
  endAt         DateTime     @map("end_at") @db.Timestamptz(6)
  sortOrder     Int          @default(0) @map("sort_order")

  timeline      DashaTimeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  antardashas   Antardasha[]

  @@index([timelineId, startAt])
  @@index([lord])
  @@index([status, deletedAt])
  @@map("mahadashas")
}

model Antardasha {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdBy     String?      @map("created_by") @db.Uuid
  updatedBy     String?      @map("updated_by") @db.Uuid
  status        RecordStatus @default(ACTIVE)

  mahadashaId   String       @map("mahadasha_id") @db.Uuid
  lord          PlanetName
  startAt       DateTime     @map("start_at") @db.Timestamptz(6)
  endAt         DateTime     @map("end_at") @db.Timestamptz(6)
  sortOrder     Int          @default(0) @map("sort_order")

  mahadasha     Mahadasha    @relation(fields: [mahadashaId], references: [id], onDelete: Cascade)
  pratyantars   PratyantarDasha[]

  @@index([mahadashaId, startAt])
  @@index([status, deletedAt])
  @@map("antardashas")
}

