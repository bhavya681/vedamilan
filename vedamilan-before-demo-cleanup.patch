-    const name = member.name.trim().toLowerCase();
-    if (seenId.has(member.id) || seenEmail.has(email) || seenName.has(name)) continue;
-    seenId.add(member.id);
-    seenEmail.add(email);
-    seenName.add(name);
-    out.push(member);
-  }
-  return out;
-}
